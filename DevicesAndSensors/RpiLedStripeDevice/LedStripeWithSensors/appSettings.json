{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "MqttConfig": {
    "ClientId": "raspberry",
    "WebSocketServer": "wss://homecontrol-app.greenwater-2aa7f6a2.polandcentral.azurecontainerapps.io/mqtt",
    "User": "raspberry",
    "Password": "",
    "OverrideTopic": "entrance/override",
    "MotionDetectedTopic": "entrance/motion"
  },
  "MotionSensorsConfig": {
    "LeftMotionDetectorPin": 6,
    "RightMotionDetectorPin": 11
  },
  "Animations": {
    "FlyingBallsAnimation": {
      "StaticBallsCount": 1,
      "MovingBallsCount": 3
    }
  },
  "Neopixel": {
    "Pin": 10,
    "Width": 100
  },
  "Manager": {
    "FrameDurationMs": 40,
    "SwitchOffDelaySec": 25,
    "DontRunAtDaylight": true
  },
  "AllowedHosts": "*"
}
